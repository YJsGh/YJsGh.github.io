---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, isoDate } from '../lib/date';
import { navSections } from '../lib/sections';

const [posts, devlog] = await Promise.all([getCollection('posts'), getCollection('devlog')]);

const recent = [
  ...posts.map((entry) => ({ ...entry, base: '/posts' })),
  ...devlog.map((entry) => ({ ...entry, base: '/devlog' })),
]
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<BaseLayout title="yj" description="사유와 감상, 개발일지를 모아두는 곳.">
  <h1>yj</h1>

  <ul>
    {
      navSections.map((section) => (
        <li>
          <a href={section.href}>{section.label}</a> — {section.description}
        </li>
      ))
    }
  </ul>

  <h2>최근 글</h2>
  <ul>
    {
      recent.map((entry) => (
        <li>
          <a href={`${entry.base}/${entry.id}/`}>{entry.data.title}</a>
          <br />
          <time datetime={isoDate(entry.data.pubDate)}>{formatDate(entry.data.pubDate)}</time>
        </li>
      ))
    }
  </ul>
</BaseLayout>
