---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, isoDate } from '../../lib/date';
import { sections } from '../../lib/sections';

const section = sections.devlog;

const [devlog, projects] = await Promise.all([
  getCollection('devlog'),
  getCollection('projects'),
]);

const projectTitles = new Map(projects.map((project) => [project.id, project.data.title]));

const entries = devlog.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout title={section.label} description={section.description}>
  <h1>{section.label}</h1>

  <ul>
    {
      entries.map(({ id, data }) => (
        <li>
          <a href={`/devlog/${id}/`}>{data.title}</a>
          <br />
          <small>
            <a href={`/projects/${data.project.id}/`}>{projectTitles.get(data.project.id)}</a>
          </small>
          <br />
          <time datetime={isoDate(data.pubDate)}>{formatDate(data.pubDate)}</time>
        </li>
      ))
    }
  </ul>
</BaseLayout>
