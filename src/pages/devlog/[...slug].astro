---
import type { CollectionEntry } from 'astro:content';
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, isoDate } from '../../lib/date';

export async function getStaticPaths() {
  const devlog = await getCollection('devlog');
  return devlog.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'devlog'>;
}

const { entry } = Astro.props;
const project = await getEntry(entry.data.project);
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article>
    <p>
      <a href={`/projects/${project.id}/`}>{project.data.title}</a>
    </p>
    <h1>{entry.data.title}</h1>
    <p>
      <time datetime={isoDate(entry.data.pubDate)}>{formatDate(entry.data.pubDate)}</time>
    </p>
    <Content />
  </article>
</BaseLayout>
