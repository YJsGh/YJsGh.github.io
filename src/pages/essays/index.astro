---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, isoDate } from '../../lib/date';

const essays = (await getCollection('essays')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout title="에세이" description="대상이 없는 사유 글.">
  <h1>에세이</h1>

  <ul>
    {
      essays.map((entry) => (
        <li>
          <a href={`/essays/${entry.id}/`}>{entry.data.title}</a>
          <br />
          <time datetime={isoDate(entry.data.pubDate)}>{formatDate(entry.data.pubDate)}</time>
        </li>
      ))
    }
  </ul>
</BaseLayout>
